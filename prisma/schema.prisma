generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  EWALLET
  SAVINGS
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  WEB
  TELEGRAM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// ผู้ดูแล: สร้างรหัสเชิญสมาชิกใหม่ได้ (ผู้ใช้คนแรกของระบบ)
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  goals          Goal[]
  telegram       TelegramLink?
  telegramCodes  TelegramLinkCode[]
  monthCloses    MonthClose[]
  invitesCreated InviteCode[]       @relation("InviteCreatedBy")
  inviteUsed     InviteCode?        @relation("InviteUsedBy")

  @@map("users")
}

model Account {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  name           String
  type           AccountType
  icon           String      @default("💵")
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(14, 2)
  archived       Boolean     @default(false)
  sortOrder      Int         @default(0) @map("sort_order")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]  @relation("TransactionAccount")
  incomingTransfers Transaction[]  @relation("TransactionToAccount")
  telegramDefaults  TelegramLink[]
  goals             Goal[]
  monthCloses       MonthClose[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  name      String
  type      CategoryType
  icon      String       @default("📦")
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, type, name])
  @@map("categories")
}

/// หัวใจของระบบ: ทุกการเคลื่อนไหวของเงิน
/// INCOME/EXPENSE ใช้ accountId + categoryId, TRANSFER ใช้ accountId (ต้นทาง) + toAccountId (ปลายทาง)
model Transaction {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  accountId   String            @map("account_id")
  toAccountId String?           @map("to_account_id")
  categoryId  String?           @map("category_id")
  type        TransactionType
  amount      Decimal           @db.Decimal(14, 2)
  date        DateTime          @db.Date
  description String            @default("")
  note        String?
  source      TransactionSource @default(WEB)
  closeItem   MonthCloseItem?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account   @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount Account?  @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@map("transactions")
}

/// งบประมาณรายเดือน (ใช้ซ้ำทุกเดือน) — categoryId = null คืองบรวมทั้งเดือน
model Budget {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  categoryId String?  @map("category_id")
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  name          String
  icon          String    @default("🎯")
  targetAmount  Decimal   @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(14, 2)
  targetDate    DateTime? @map("target_date") @db.Date
  /// บัญชีที่เก็บเงินของเป้าหมายนี้ — ตอนปิดยอดเดือนจะสร้างรายการโอนเข้าบัญชีนี้
  accountId     String?   @map("account_id")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  closeItems MonthCloseItem[]

  @@index([userId])
  @@map("goals")
}

/// บัญชี Telegram ที่เชื่อมกับผู้ใช้ (หนึ่งผู้ใช้ต่อหนึ่งแชต)
model TelegramLink {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  chatId           String   @unique @map("chat_id")
  username         String?
  firstName        String?  @map("first_name")
  defaultAccountId String?  @map("default_account_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAccount Account? @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)

  @@map("telegram_links")
}

/// รหัสใช้ครั้งเดียวสำหรับเชื่อม Telegram (t.me/<bot>?start=<code>)
model TelegramLinkCode {
  code      String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_link_codes")
}

/// รหัสเชิญสำหรับสมัครสมาชิก — ใช้ได้ครั้งเดียว มีวันหมดอายุ
model InviteCode {
  code        String    @id
  note        String?
  createdById String    @map("created_by_id")
  usedById    String?   @unique @map("used_by_id")
  usedAt      DateTime? @map("used_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("invite_codes")
}

/// การปิดยอดเดือน: บันทึกว่าเงินที่เหลือของเดือนนั้นถูกแบ่งไปไหน (หนึ่งครั้งต่อเดือน)
model MonthClose {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  month           String /// "YYYY-MM"
  income          Decimal  @db.Decimal(14, 2)
  expense         Decimal  @db.Decimal(14, 2)
  sourceAccountId String?  @map("source_account_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount Account?         @relation(fields: [sourceAccountId], references: [id], onDelete: SetNull)
  items         MonthCloseItem[]

  @@unique([userId, month])
  @@map("month_closes")
}

model MonthCloseItem {
  id            String  @id @default(cuid())
  closeId       String  @map("close_id")
  goalId        String? @map("goal_id")
  goalName      String  @map("goal_name")
  amount        Decimal @db.Decimal(14, 2)
  /// รายการโอนที่สร้างตอนปิดยอด (ถ้ามี)
  transactionId String? @unique @map("transaction_id")

  close       MonthClose   @relation(fields: [closeId], references: [id], onDelete: Cascade)
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([closeId])
  @@map("month_close_items")
}
