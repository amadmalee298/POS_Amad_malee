# PostgreSQL connection string (Neon / Supabase / Vercel Postgres / local)
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance"

# Auth.js secret — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me"

# เว็บไซต์จริง (ใช้ในลิงก์จากบอต และเป็นค่าเริ่มต้นของ npm run telegram:setup)
APP_URL="https://your-app.vercel.app"

# Telegram bot (ไม่บังคับ) — สร้างบอตกับ @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""        # ชื่อบอตไม่ต้องมี @ เช่น my_finance_bot
TELEGRAM_WEBHOOK_SECRET=""      # สร้างด้วย: openssl rand -hex 32

# Vercel Cron (เตือนปิดยอดเดือนทาง Telegram ทุกวันที่ 1) — สร้างด้วย: openssl rand -hex 32
CRON_SECRET=""
